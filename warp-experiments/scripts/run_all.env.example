# Copy this file to one of:
#   .vecio-run.env
#   scripts/run_all.env
# or point VECIO_ENV_FILE at your custom path.
#
# Then run:
#   bash scripts/run_all.sh

# REQUIRED: an S3 bucket the current AWS credentials can write to.
# Runners that need a real-S3 blob (Figure 4's tiny-request fanout,
# closed-loop, figure-qps-vs-savings, sift1m-sensitivity, scale-vs-
# geometry) will upload their own per-run cluster blob here on demand;
# you do not need to pre-load anything.
VECIO_S3_BUCKET=your-bucket-name
VECIO_S3_REGION=ap-northeast-1

# OPTIONAL for Figures 7, 8, and 11: writable prefix where preparation creates
# or validates matched Lance datasets. If unset, the default is
# s3://$VECIO_S3_BUCKET/real-lance-format-sanity.
# VECIO_REAL_LANCE_S3_ROOT=s3://your-bucket-name/real-lance-format-sanity

# Optional override for Figure 7 whole-process NIC accounting. If omitted,
# the runner uses the interface carrying the Linux default route.
# VECIO_NETWORK_INTERFACE=ens5

# OPTIONAL: Figure 4's S3 object (the 512 MB merged-cluster blob that
# the tiny-request fanout figure reads from). Three resolution modes:
#
#   1. Leave this unset AND set VECIO_S3_BUCKET above — the runner will
#      synthesise a 512 MB blob and upload it under
#      s3://$VECIO_S3_BUCKET/figure04_synth/<timestamp>/blob_*.bin,
#      then use that URI. This is the expected reviewer flow.
#
#   2. Point at an existing Lance-format clusters_merged.bin you have
#      write access to (e.g. produced by an earlier full-mode run):
#
# VECIO_FIG4_TINY_REQUEST_URI=s3://your-bucket-name/pipeline/sift1m/<ts>/clusters_merged.bin
#
#   Leave this and VECIO_S3_BUCKET both unset only for light/offline rendering;
#   a real measurement requires a reader-owned bucket or explicit URI.

# REQUIRED for full mode. Point at the downloaded/extracted or checked-out
# paper companion source. run_all.sh deliberately never clones or changes it.
# Figure 11 preflight additionally requires strict_budget_real_s3
# --only-method and full_pipeline_real_s3 --out-query-ranges-json.
# The pinned public companion release includes both capabilities.
# VECIO_LANCE_ROOT=/path/to/lance-s3-io-optimization

# OPTIONAL: reuse an existing Figure 11 reordered MSong M=60 object instead
# of the one prepared below VECIO_REAL_LANCE_S3_ROOT.
# VECIO_FIG11_MSONG_URI=s3://your-bucket-name/path/msong_pq_reorder.lance
# Pair an external object with a build manifest or frozen inventory that pins
# its physical index UUID.
# VECIO_FIG11_MSONG_INDEX_IDENTITY=/path/to/msong-index-identity.json

# Figure 4 is the only global run that inherently spans network locations.
# Each value is TARGET,BUCKET,REGION,SAMPLES; TARGET may be local or SSH.
# VECIO_FIG4_AP_SAME_REGION=ap-host,ap-bucket,ap-northeast-1,30
# VECIO_FIG4_US_SAME_REGION=us-host,us-bucket,us-east-1,300
# VECIO_FIG4_CROSS_REGION=us-host,ap-bucket,ap-northeast-1,300
# VECIO_FIG4_PUBLIC_INTERNET=local,ap-bucket,ap-northeast-1,300
